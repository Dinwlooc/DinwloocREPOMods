<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<Authors>Dinwlooc</Authors>
		<Version>1.0.0</Version>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		
		<!-- 基础标识（BepInEx 插件信息会通过代码中的 PluginInfo 类提供） -->
		<AssemblyName>REPO_Dinwlooc_Lib</AssemblyName>
		<RootNamespace>Dinwlooc.Common</RootNamespace>
		
		<!-- 部署控制：不自动复制到游戏插件文件夹（开发者手动复制或通过发布任务） -->
		<CopyPluginToGameFolder>false</CopyPluginToGameFolder>
		<DeployToGame>false</DeployToGame>
		<AutoDeploy>false</AutoDeploy>
		<PluginDeploy>false</PluginDeploy>
		<CopyToPlugin>false</CopyToPlugin>
		<PluginFolder></PluginFolder>
	</PropertyGroup>

	<PropertyGroup>
		<RestoreAdditionalProjectSources>
			https://api.nuget.org/v3/index.json;
			https://nuget.bepinex.dev/v3/index.json;
			https://nuget.windows10ce.com/nuget/v3/index.json
		</RestoreAdditionalProjectSources>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" IncludeAssets="build" />
		<PackageReference Include="Linkoid.Repo.Plugin.Build" Version="*" PrivateAssets="all" />
		<PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
		<PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
		<PackageReference Include="R.E.P.O.GameLibs.Steam" Version="*-*" PrivateAssets="all" />
	</ItemGroup>

	<!-- 源代码包含规则 -->
	<ItemGroup>
		<Compile Include="src\**\*.cs" />
	</ItemGroup>

	<!-- 本地依赖库（REPOLib 和 MenuLib 放置在项目根目录的 Libs 文件夹中） -->
	<ItemGroup>
		<Reference Include="REPOLib">
			<HintPath>Libs\REPOLib.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="MenuLib">
			<HintPath>Libs\MenuLib.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="src\新文件夹\" />
	</ItemGroup>

	<!-- 发布任务（可选）：在 Release 编译时生成可分发包 -->
	<Target Name="PreparePublish" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<PublishRoot>$(ProjectDir)Publish\</PublishRoot>
			<PublishVersion>$(Version)</PublishVersion>
			<PublishFolder>$(PublishRoot)REPO_Dinwlooc_Lib-$(PublishVersion)\</PublishFolder>
		</PropertyGroup>
		<MakeDir Directories="$(PublishFolder)plugins" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PublishFolder)plugins" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(PublishFolder)plugins" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
		<Copy SourceFiles="$(ProjectDir)README.md" DestinationFolder="$(PublishFolder)" Condition="Exists('$(ProjectDir)README.md')" />
		<Copy SourceFiles="$(ProjectDir)LICENSE" DestinationFolder="$(PublishFolder)" Condition="Exists('$(ProjectDir)LICENSE')" />
		<Message Text="发布包已生成: $(PublishFolder)" Importance="High" />
	</Target>

	<!-- 覆盖可能存在的自动部署任务（保留原样） -->
	<Target Name="OverrideDeploy" BeforeTargets="CopyToPluginOutputItems">
		<PropertyGroup>
			<PluginFolder></PluginFolder>
			<CopyToPlugin>false</CopyToPlugin>
		</PropertyGroup>
	</Target>

	<!-- ================ 新增目标：复制 DLL 到上级各模组的 Libs 文件夹（仅 Release） ================ -->
	<Target Name="CopyToOtherMods" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
		<Exec Command="powershell -NoProfile -NonInteractive -Command &quot;&amp; { $base='D:\BepInEx_Project\R.E.P.O'; $src='$(TargetPath)'; $exclude=@('REPO_Dinwlooc_Lib','.vs','.git'); if (Test-Path $base) { Get-ChildItem $base -Directory | Where-Object { $exclude -notcontains $_.Name } | ForEach-Object { $libDir=Join-Path $_.FullName 'Libs'; if (!(Test-Path $libDir)) { New-Item -ItemType Directory -Path $libDir -Force | Out-Null }; if (Test-Path $src) { Copy-Item $src $libDir -Force; Write-Host &quot;Copied to $libDir&quot; } } } else { Write-Host 'Base directory not found: $base' -ForegroundColor Yellow } }&quot;" />
	</Target>

</Project>